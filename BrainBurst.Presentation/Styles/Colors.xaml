<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PrimaryBrandColor">#FF4500</Color>
    <SolidColorBrush x:Key="PrimaryBrandBrush" Color="{StaticResource PrimaryBrandColor}"/>

    <Color x:Key="PrimaryButtonBgColor">Black</Color>
    <SolidColorBrush x:Key="PrimaryButtonBgBrush" Color="{StaticResource PrimaryButtonBgColor}"/>

    <Color x:Key="SecondaryButtonBgColor">#555555</Color>
    <SolidColorBrush x:Key="SecondaryButtonBgBrush" Color="{StaticResource SecondaryButtonBgColor}"/>

    <Color x:Key="ButtonTextColor">White</Color>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="{StaticResource ButtonTextColor}"/>

</ResourceDictionary>