<Window x:Class="BrainBurst.Presentation.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BrainBurst.Presentation"
        mc:Ignorable="d"
        Title="Вхід"
        Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid>
        <Button Content="← Повернутися на головну"
            Style="{StaticResource BackButton}"
            Click="BackButton_Click"/>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">

            <Image Source="/Assets/logo.png" 
                   Height="150"
                   Margin="0,0,0,10"/>

            <TextBlock Text="BRAIN BURST"
                       FontSize="48"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrandBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <TextBox Style="{StaticResource InputTextBox}" 
                     Tag="Введіть електронну пошту або ім'я користувача" Text=""
                     Margin="0,0,0,10"/>

            <TextBlock Text="Введіть пароль" 
                       FontWeight="Bold" 
                       Margin="0,0,0,5" 
                       Foreground="#555"/>
            <PasswordBox Style="{StaticResource InputPasswordBox}"/>

            <Button Content="Увійти"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,20,0,0"
                    Click="Login_Click"/>

        </StackPanel>
    </Grid>
</Window>