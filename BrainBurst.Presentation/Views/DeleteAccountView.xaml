<UserControl x:Class="BrainBurst.Presentation.Views.DeleteAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BrainBurst.Presentation.Views"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1180"
             Background="White">
    <Grid Margin="40">

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="700">

            <TextBlock Text="Видалення акаунту" FontSize="28" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"
                       Foreground="{StaticResource PrimaryBrandBrush}"/>

            <TextBlock FontSize="16" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                       Foreground="#555">
                Ви впевнені, що хочете назавжди видалити свій акаунт?
                <LineBreak/><LineBreak/>
                <Run FontWeight="Bold">Вся ваша інформація, включаючи всі картки, тести та прогрес, буде назавжди втрачена.</Run>
                <LineBreak/>
                Цю дію неможливо скасувати.
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">

                <Button Content="Ні, скасувати" 
                        Style="{StaticResource SettingsButton}"
                        Margin="0,0,10,0"
                        Click="NoButton_Click"/>

                <Button Content="Так, видалити" 
                        Style="{StaticResource SettingsButtonDelete}"
                        Margin="0,0,10,0"
                        Click="YesButton_Click"/>

            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>