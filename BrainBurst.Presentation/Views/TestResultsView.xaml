<UserControl x:Class="BrainBurst.Presentation.Views.TestResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BrainBurst.Presentation.Views"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1180"
             Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">

                <TextBlock Text="Тест завершено!" FontSize="48" FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryBrandBrush}"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="ScoreText" 
                           Text="Ваш результат: 0 / 0" 
                           FontSize="28" 
                           FontWeight="SemiBold"
                           Foreground="Gray"
                           Margin="0,20,0,5"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="PercentageText" 
                           Text="(0%)" 
                           FontSize="42" 
                           FontWeight="Bold"
                           Foreground="Green"
                           Margin="0,0,0,40"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="MistakesHeader"
                           Text="Ваші помилки:" 
                           FontSize="22" 
                           FontWeight="Bold"
                           Margin="0,0,0,10"
                           Visibility="Collapsed"/>

                <ItemsControl x:Name="MistakesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AwardPanel}" Background="#FFF0F0" Margin="0,5">
                                <StackPanel>
                                    <TextBlock Text="{Binding QuestionText}" 
                                               FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Ваша відповідь:" 
                                               FontSize="12" FontWeight="Bold" Foreground="Gray" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding UserAnswer}" 
                                               FontSize="14" Foreground="Red" TextDecorations="Strikethrough"/>
                                    <TextBlock Text="Правильна відповідь:" 
                                               FontSize="12" FontWeight="Bold" Foreground="Gray" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding CorrectAnswer}" 
                                               FontSize="14" Foreground="Green"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="Назад" 
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,40,0,0"
                        Click="BackButton_Click"/>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>