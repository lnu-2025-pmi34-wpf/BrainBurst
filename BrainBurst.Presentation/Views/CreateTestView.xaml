<UserControl x:Class="BrainBurst.Presentation.Views.CreateTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BrainBurst.Presentation.Views"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1180"
             Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40" HorizontalAlignment="Center" Width="800">

            <Button Content="← Назад"
                    Style="{StaticResource BackButton}"
                    Click="BackButton_Click"
                    Margin="0,0,0,10"/>

            <TextBlock Text="Створення нового тесту" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Назва тесту" FontWeight="Bold" Margin="0,0,0,5" Foreground="#555"/>
            <TextBox x:Name="TestNameTextBox" 
                     Style="{StaticResource InputTextBox}" 
                     Tag="Назва вашого тесту (напр., 'Тест з математики')" Text=""/>

            <TextBlock Text="Оберіть колоди карток" FontWeight="Bold" Margin="0,10,0,5" Foreground="#555"/>

            <ListBox x:Name="DeckListBox" 
                     SelectionMode="Multiple"
                     ItemContainerStyle="{StaticResource DeckSelectionListBoxItemStyle}"
                     BorderThickness="0"
                     Background="Transparent">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                
                <ListBox.ItemTemplate>
                    <DataTemplate>
                         <StackPanel>
                            <TextBlock Text="{Binding TagsStr}" Style="{StaticResource AwardTitleText}"/> 
                            <TextBlock Text="{Binding CreatedAt, StringFormat='створено: {0:dd/MM/yyyy}'}" Style="{StaticResource AwardSubText}" Margin="0,10,0,0"/>
                         </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            
            <TextBlock x:Name="StatusText" Margin="0,10,0,0" Foreground="Red" HorizontalAlignment="Right" FontWeight="SemiBold"/>

            <Button Content="Створити тест"
                    Style="{StaticResource PrimaryButton}"
                    Width="300"
                    Margin="0,30,0,0"
                    HorizontalAlignment="Right"
                    Click="GenerateTest_Click"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>