<UserControl x:Class="BrainBurst.Presentation.Views.CreateTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BrainBurst.Presentation.Views"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1180"
             Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40" HorizontalAlignment="Center" Width="800">

            <Button Content="← Назад"
                    Style="{StaticResource BackButton}"
                    Click="BackButton_Click"
                    Margin="0,0,0,10"/>

            <TextBlock Text="Створення нового тесту" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Назва тесту" FontWeight="Bold" Margin="0,0,0,5" Foreground="#555"/>
            <TextBox Style="{StaticResource InputTextBox}" Tag="Назва вашого тесту (напр., 'Тест з математики')" Text=""/>

            <TextBlock Text="Оберіть колоди карток" FontWeight="Bold" Margin="0,10,0,5" Foreground="#555"/>

            <ListBox SelectionMode="Multiple"
                     ItemContainerStyle="{StaticResource DeckSelectionListBoxItemStyle}"
                     BorderThickness="0"
                     Background="Transparent">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBoxItem>
                    <StackPanel>
                        <TextBlock Text="дискретна математика" Style="{StaticResource AwardTitleText}"/>
                        <TextBlock Text="створено: 13/04/2023" Style="{StaticResource AwardSubText}" Margin="0,10,0,0"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel>
                        <TextBlock Text="математичний аналіз" Style="{StaticResource AwardTitleText}"/>
                        <TextBlock Text="створено: 24/03/2023" Style="{StaticResource AwardSubText}" Margin="0,10,0,0"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel>
                        <TextBlock Text="психологія" Style="{StaticResource AwardTitleText}"/>
                        <TextBlock Text="створено: 15/01/2025" Style="{StaticResource AwardSubText}" Margin="0,10,0,0"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel>
                        <TextBlock Text="англійська мова" Style="{StaticResource AwardTitleText}"/>
                        <TextBlock Text="створено: 01/02/2021" Style="{StaticResource AwardSubText}" Margin="0,10,0,0"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel>
                        <TextBlock Text="програмування" Style="{StaticResource AwardTitleText}"/>
                        <TextBlock Text="створено: 03/03/2024" Style="{StaticResource AwardSubText}" Margin="0,10,0,0"/>
                    </StackPanel>
                </ListBoxItem>

            </ListBox>
            <Button Content="Створити тест" 
                    Style="{StaticResource PrimaryButton}"
                    Width="300"
                    Margin="0,30,0,0"
                    HorizontalAlignment="Right"
                    Click="GenerateTest_Click"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>