<UserControl x:Class="BrainBurst.Presentation.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BrainBurst.Presentation.Views"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1180"
             Background="White">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Налаштування" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Style="{StaticResource SettingsContainer}"
                VerticalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <StackPanel>
                    <Button Content="Змінити пароль" 
                            Style="{StaticResource SettingsButton}"
                            Click="ChangePasswordButton_Click"/>

                    <Button Content="Вийти з акаунту" 
                            Style="{StaticResource SettingsButton}"
                            Click="LogoutButton_Click"/>

                    <Button Content="Видалити акаунт" 
                            Style="{StaticResource SettingsButtonDelete}"
                            Click="DeleteAccountButton_Click"/> 
                </StackPanel>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>