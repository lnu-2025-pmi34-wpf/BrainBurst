<UserControl x:Class="BrainBurst.Presentation.Views.TestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BrainBurst.Presentation.Views"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1180"
             Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40">
            <TextBlock Text="Мої тести" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <Grid Margin="0,0,0,20">
                <TextBox Style="{StaticResource SearchBox}" Tag="Пошук..." Text=""/>
                <TextBlock Text="🔍" FontSize="20" 
                           HorizontalAlignment="Right" 
                           VerticalAlignment="Center" 
                           Margin="0,0,15,0"
                           Foreground="#888"/>
            </Grid>

<TextBlock Text="Доступні тести (на основі колод)" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
            
            <TextBlock x:Name="NoTestsMessage" 
                       Text="Тести не знайдено. Створіть картки, щоб мати можливість генерувати тест." 
                       Visibility="Collapsed" 
                       Margin="0,10,0,20" 
                       Foreground="Gray"/>

            <WrapPanel>
                
                <ItemsControl x:Name="DecksItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DeckCard}" 
                                    MouseLeftButtonDown="Test_Click">
                                <StackPanel>
                                    <TextBlock Text="{Binding DeckTag}" Style="{StaticResource AwardTitleText}"/>
                                    <TextBlock Text="{Binding CardCount, StringFormat='{}Питань: {0}'}" 
                                               Style="{StaticResource AwardSubText}" 
                                               Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <Button Style="{StaticResource AddDeckButton}" Click="CreateTest_Click"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>