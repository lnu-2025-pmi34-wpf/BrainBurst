<UserControl x:Class="BrainBurst.Presentation.Views.EditProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BrainBurst.Presentation.Views"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1180"
             Background="White">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="← Назад"
                Style="{StaticResource BackButton}"
                Click="BackButton_Click"
                Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="Редагування профілю" FontSize="28" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <Button Content="Змінити фото профіля" 
                    Style="{StaticResource SettingsButton}"/>

            <Button Content="Змінити ім'я користувача" 
                    Style="{StaticResource SettingsButton}"
                    Click="ChangeUsernameButton_Click"/>
            <StackPanel x:Name="ChangeUsernamePanel"
                        Visibility="Collapsed" 
                        Margin="0,10,0,0"
                        Width="300">

                <TextBlock Text="Введіть нове ім'я:" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="NewUsernameTextBox" Style="{StaticResource InputTextBox}" Tag="Нове ім'я" Text=""/>

                <TextBlock x:Name="UsernameStatusText" Margin="0,5,0,0" FontWeight="SemiBold"/>

            </StackPanel>

            <Button Content="Зберегти" 
                    Style="{StaticResource SettingsButtonDelete}"
                    Margin="0,30,0,0"
                    Click="SaveButton_Click"/>

        </StackPanel>
    </Grid>
</UserControl>