<UserControl x:Class="BrainBurst.Presentation.Views.AwardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BrainBurst.Presentation.Views"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1180"
             Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="40">
            <TextBlock Text="Рейтинг" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="№" Style="{StaticResource RatingHeader}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="ім'я користувача" Style="{StaticResource RatingHeader}" Margin="5"/>
                <TextBlock Grid.Column="2" Text="бали" Style="{StaticResource RatingHeader}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="ранг" Style="{StaticResource RatingHeader}" HorizontalAlignment="Center"/>
            </Grid>

            <ItemsControl x:Name="LeaderboardItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource RatingNumberCell}">
                                <TextBlock Text="{Binding UserId}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource RatingDataCell}">
                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold"/>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource RatingDataCell}">
                                <TextBlock Text="{Binding Points}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                            </Border>

                            <Border Grid.Column="3" Style="{StaticResource RatingDataCell}">
                                <TextBlock Text="{Binding Rank}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>

        <Grid Grid.Column="1" Background="{StaticResource PrimaryBrandBrush}">
            <Viewbox Stretch="Uniform" Margin="20">
                <Grid Width="400" Height="300">
                    <Border Background="Transparent" BorderBrush="White" BorderThickness="4"
                            Width="120" Height="150"
                            VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,0"/>
                    <TextBlock Text="1" Foreground="White" FontSize="100" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>

                    <Border Background="Transparent" BorderBrush="White" BorderThickness="4"
                            Width="120" Height="120"
                            VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,20,0"/>
                    <TextBlock Text="2" Foreground="White" FontSize="100" FontWeight="Bold"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,0"/>

                    <Border Background="Transparent" BorderBrush="White" BorderThickness="4"
                            Width="120" Height="100"
                            VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="20,0,0,0"/>
                    <TextBlock Text="3" Foreground="White" FontSize="100" FontWeight="Bold"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="33,0,0,-7"/>
                </Grid>
            </Viewbox>
        </Grid>
    </Grid>
</UserControl>