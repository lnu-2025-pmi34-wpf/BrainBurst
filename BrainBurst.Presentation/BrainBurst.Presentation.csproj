    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\achievements.png" />
    <None Remove="Assets\cards.png" />
    <None Remove="Assets\logo-black.png" />
    <None Remove="Assets\logo.png" />
    <None Remove="Assets\settings.png" />
    <None Remove="Assets\tests.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\achievements.png" />
    <Resource Include="Assets\cards.png" />
    <Resource Include="Assets\logo-black.png" />
