<Window x:Class="BrainBurst.Presentation.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BrainBurst.Presentation"
        mc:Ignorable="d"
        Title="Brain Burst - Профіль" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PrimaryBrandBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <RadioButton Grid.Row="0" 
                             Style="{StaticResource SideNavButton}" 
                             IsChecked="True"
                             Margin="0,10,0,0"
                             x:Name="ProfileButton"
                             Click="ProfileButton_Click"
                             GroupName="SideNav">
                    <Image Source="/Assets/logo-black.png" Height="45"/>
                </RadioButton>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource SideNavButton}"
                                 x:Name="CardsButton"
                                 Click="CardsButton_Click"
                                 GroupName="SideNav">
                        <Image Source="/Assets/cards.png" Height="45" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource SideNavButton}"
                                 x:Name="TestsButton"
                                 GroupName="SideNav"
                                 Click="TestsButton_Click">
                        <Image Source="/Assets/tests.png" Height="45" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource SideNavButton}"
                                 x:Name="AwardsButton"
                                 GroupName="SideNav"
                                 Click="AwardsButton_Click">
                        <Image Source="/Assets/achievements.png" Height="45" />
                    </RadioButton>
                </StackPanel>

                <RadioButton Grid.Row="2"
                             Style="{StaticResource SideNavButton}" 
                             VerticalAlignment="Bottom" 
                             Margin="0,0,0,10"
                             x:Name="SettingsButton"
                             GroupName="SideNav"
                             Click="SettingsButton_Click">
                    <Image Source="/Assets/settings.png" Height="45" />
                </RadioButton>

            </Grid>
        </Border>

        <Frame Grid.Column="1"
               x:Name="MainFrame"
               NavigationUIVisibility="Hidden"/>

    </Grid>
</Window>